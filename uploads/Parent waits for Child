#include <stdio.h>
#include <unistd.h>
#include <sys/wait.h>

int main() {
    pid_t pid = fork();

    if(pid == 0) {
        // Child process
        printf("Child is running\n");
    } else if(pid > 0) {
        // Parent process waits
        wait(NULL);
        printf("Parent runs after child finishes\n");
    } else {
        printf("Fork failed\n");
    }

    return 0;
}
