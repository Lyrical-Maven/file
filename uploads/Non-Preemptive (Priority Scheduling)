n = int(input("Enter number of processes: "))
bt = list(map(int, input("Enter burst times: ").split()))
priority = list(map(int, input("Enter priority: ").split()))

process = list(range(n))

# sort by priority (lower = higher priority)
for i in range(n):
    for j in range(i+1, n):
        if priority[i] > priority[j]:
            priority[i], priority[j] = priority[j], priority[i]
            bt[i], bt[j] = bt[j], bt[i]
            process[i], process[j] = process[j], process[i]

wt = [0]*n
tat = [0]*n

for i in range(1, n):
    wt[i] = wt[i-1] + bt[i-1]

for i in range(n):
    tat[i] = wt[i] + bt[i]

print("\nP  BT  WT  TAT")
for i in range(n):
    print(f"P{process[i]+1} {bt[i]} {wt[i]} {tat[i]}")
