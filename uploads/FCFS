n = int(input("Enter number of processes: "))
bt = list(map(int, input("Enter burst times: ").split()))

wt = [0]*n
tat = [0]*n

for i in range(1, n):
    wt[i] = wt[i-1] + bt[i-1]

for i in range(n):
    tat[i] = wt[i] + bt[i]

print("\nP  BT  WT  TAT")
for i in range(n):
    print(f"P{i+1} {bt[i]} {wt[i]} {tat[i]}")
