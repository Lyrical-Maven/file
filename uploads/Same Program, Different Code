#include <stdio.h>
#include <unistd.h>

int main() {
    pid_t pid = fork();

    if(pid == 0) {
        // Child process
        printf("This is CHILD process\n");
    } else if(pid > 0) {
        // Parent process
        printf("This is PARENT process\n");
    } else {
        printf("Fork failed\n");
    }

    return 0;
}
