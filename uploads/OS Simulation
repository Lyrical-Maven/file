import time

processes = input("Enter process names (space-separated): ").split()

print("\n--- OS Simulation Start ---\n")

for p in processes:
    print(f"{p} is in READY state")
    time.sleep(1)

    print(f"{p} is RUNNING")
    time.sleep(1)

    print(f"{p} is TERMINATED\n")
    time.sleep(1)

print("--- Simulation End ---")
